<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy manifest for the keyboard extension.

  The extension ships as its own bundle inside the app, so it carries its own
  manifest; Xcode aggregates the app's and the extension's into one privacy
  report at archive time.

  A custom keyboard is the most privacy-sensitive extension point on iOS, and
  the honest answer here is short: this one collects nothing and sends nothing.
  RequestsOpenAccess is true (project.yml) for one reason: key press haptics,
  which iOS refuses to deliver from a keyboard extension without Full Access.
  Granting it is the user's choice, it is off until turned on in Settings, and
  everything except haptics works without it. There is no networking code
  anywhere in this extension or its host app - no URLSession, no sockets, no
  third-party SDK that could carry data off the device.

  Reason codes, both real:

    1C8F.1  reads the App Group suite for layout and key-face preferences
            written by the host app (Shared/LayoutMode.swift). Reachable once
            the user grants Full Access; until then iOS denies the shared
            container - hence the fallback below.
    CA92.1  reads and writes the extension's own standard defaults, the
            fallback path used whenever the shared container is unavailable.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>1C8F.1</string>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
